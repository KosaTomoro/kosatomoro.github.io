{
  "name": "kosa-tomoro-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test && npm run test:content",
    "test:content": "node scripts/test-content.mjs",
    "new": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@supabase/supabase-js": "2.119.0",
    "astro": "7.4.5",
    "pagefind": "1.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
