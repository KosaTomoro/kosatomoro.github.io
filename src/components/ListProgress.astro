---
import { orderedLifeList } from '../data/list100';
// One cell per List100 slot, in the order of the list page: cell N carries the status of row N.
// Pass `label` when the grid stands alone; leave it out when nearby text says the same.
interface Props { label?: string; numbered?: boolean }
const { label, numbered = false } = Astro.props;
const cells = Array.from({ length: 100 }, (_, index) => ({ number: index + 1, status: orderedLifeList[index]?.status }));
---
<span class:list={['list-progress', { numbered }]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>{cells.map(({ number, status }) => <span class:list={[status]}>{numbered && status ? number : ''}</span>)}</span>
