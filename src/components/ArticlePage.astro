---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { site } from '../config';
import { postUrl, tagUrl, dateLabel, readingMinutes, type Post } from '../lib/posts';
import { copy, categoryName, tagName, localPath, readingTime as readingLabel } from '../i18n';
import '../styles/article.css';
interface Props { post: Post }
const { post } = Astro.props;
const locale = post.locale;
const t = copy(locale);
const entry = locale === 'en' && post.translation ? post.translation : post;
const { Content, headings } = await render(entry);
// The footnotes heading is generated and visually hidden, so it stays out of the contents.
const toc = headings.filter(({ depth, slug }) => (depth === 2 || depth === 3) && slug !== 'footnote-label');
const alternate = post.translation ? postUrl(post, locale === 'zh' ? 'en' : 'zh') : null;
const readingTime = readingLabel(readingMinutes(post), locale);
---
<Base title={post.data.title} description={post.data.description} article published={post.data.date} updated={post.data.updated} alternate={alternate}>
  <div class="article-shell">
    <article data-pagefind-body>
      <div class:list={['article-content', { 'has-toc': toc.length > 0 }]}>
        <header class="article-header">
          <a class="article-back text-link" href={localPath('/blog/', locale)} data-pagefind-ignore>← {t.allPosts}</a>
          <p class="eyebrow" data-pagefind-ignore>{categoryName(post.data.category, locale)}</p>
          <h1 data-pagefind-meta="title">{post.data.title}</h1>
          <p class="article-description" data-pagefind-meta="description">{post.data.description}</p>
          <dl class="article-meta">
            <div><dt>{t.articleAuthor}</dt><dd>{site.name}</dd></div>
            <div><dt>{t.articleCategory}</dt><dd data-pagefind-filter="category">{categoryName(post.data.category, locale)}</dd></div>
            <div><dt>{t.articlePublished}</dt><dd><time datetime={post.data.date}>{dateLabel(post.data.date)}</time></dd></div>
            <div><dt>{t.articleReadingTime}</dt><dd>{readingTime}</dd></div>
            {post.data.updated && <div><dt>{t.updated}</dt><dd><time datetime={post.data.updated}>{dateLabel(post.data.updated)}</time></dd></div>}
          </dl>
        </header>
        {toc.length > 0 && <aside class="article-sidebar" data-pagefind-ignore>
          <div class="article-progress" hidden>
            <span id="article-progress-label">{t.articleProgress}</span>
            <span class="article-progress-value" aria-hidden="true">00%</span>
            <progress value="0" max="100" aria-labelledby="article-progress-label"></progress>
          </div>
          <div class="article-share" hidden><button class="share-copy" type="button" data-label={t.copyLink} data-done={t.linkCopied}>{t.copyLink}</button></div>
          <details class="article-toc" open>
            <summary>{t.contents}</summary>
            <nav aria-label={t.articleNav}><ol>{toc.map(({ slug, text, depth }) => <li class:list={{ 'toc-nested': depth === 3 }}><a href={`#${slug}`}>{text}</a></li>)}</ol></nav>
          </details>
        </aside>}
        <div class="article-reading">
          <div class="prose"><Content /></div>
          <div class="article-bottom" data-pagefind-ignore>
            <span class="article-ornament" aria-hidden="true"><Icon name="sunrise" size={22} /></span>
            <a class="text-link" href={localPath('/blog/',locale)}>← {t.returnBlog}</a>
            {post.data.tags.length > 0 && <div class="post-tags">{post.data.tags.map((tag) => <a href={tagUrl(tag, locale)}>#{tagName(tag, locale)}</a>)}</div>}
          </div>
        </div>
      </div>
    </article>
  </div>
</Base>
<script>
  import { copy, getLocale } from '../i18n';
  const t = copy(getLocale(location.pathname));
  const toc = document.querySelector<HTMLDetailsElement>('.article-toc');
  const prose = document.querySelector<HTMLElement>('.prose');
  const progress = document.querySelector<HTMLProgressElement>('.article-progress progress');
  const progressValue = document.querySelector<HTMLElement>('.article-progress-value');
  const share = document.querySelector<HTMLButtonElement>('.share-copy');
  // Copying needs a script, so the button only appears once this one is running.
  share?.parentElement?.removeAttribute('hidden');
  share?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(location.origin + location.pathname); share.textContent = share.dataset.done!; } catch { return; }
    window.setTimeout(() => { share.textContent = share.dataset.label!; }, 2400);
  });
  const narrow = matchMedia('(max-width: 620px)');
  const syncToc = () => { if (toc) toc.open = !narrow.matches; };
  syncToc();
  narrow.addEventListener('change', syncToc);
  if (toc) {
    const sections = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a')).flatMap(link => {
      const heading = document.getElementById(link.getAttribute('href')!.slice(1));
      return heading ? [{ link, heading }] : [];
    }).reverse();
    let current: HTMLAnchorElement | undefined;
    let frame: number | undefined;

    function revealCurrentSection() {
      if (!toc?.open || !current) return;
      const item = current.getBoundingClientRect();
      const panel = toc.getBoundingClientRect();
      if (item.top < panel.top) toc.scrollTop += item.top - panel.top;
      else if (item.bottom > panel.bottom) toc.scrollTop += item.bottom - panel.bottom;
    }

    function updateCurrentSection() {
      frame = undefined;
      const last = sections[0];
      if (!last) return;
      const topPadding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const offset = topPadding + parseFloat(getComputedStyle(last.heading).scrollMarginTop) + 16;
      if (prose && progress && progressValue) {
        const { top, height } = prose.getBoundingClientRect();
        const available = document.documentElement.clientHeight - offset;
        const distance = Math.max(1, height - available);
        const percent = Math.round(Math.min(1, Math.max(0, (offset - top) / distance)) * 100);
        progress.value = percent;
        progressValue.textContent = `${String(percent).padStart(2, '0')}%`;
      }
      const scroller = document.scrollingElement;
      const atEnd = scroller && scroller.scrollTop > 0 &&
        scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 2;
      const next = atEnd
        ? last.link
        : sections.find(({ heading }) => heading.getBoundingClientRect().top <= offset)?.link;
      if (next === current) return;
      current?.removeAttribute('aria-current');
      next?.setAttribute('aria-current', 'location');
      current = next;
      revealCurrentSection();
    }

    const scheduleUpdate = () => { frame ??= requestAnimationFrame(updateCurrentSection); };
    for (const { link } of sections) {
      link.addEventListener('click', () => {
        if (narrow.matches) toc.open = false;
        scheduleUpdate();
      });
    }
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);
    toc.addEventListener('toggle', revealCurrentSection);
    progress?.parentElement?.removeAttribute('hidden');
    if (prose) new ResizeObserver(scheduleUpdate).observe(prose);
    scheduleUpdate();
  }
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
    const container = document.createElement('div');
    container.className = 'code-block';
    pre.before(container); container.append(pre);
    const head = document.createElement('div');
    head.className = 'code-head';
    const language = document.createElement('span');
    language.textContent = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'code';
    const button = document.createElement('button');
    button.type = 'button'; button.className = 'copy-code';
    button.textContent = t.copy; button.setAttribute('aria-label',t.copyLabel);
    head.append(language, button); container.prepend(head);
    const status = document.createElement('span');
    status.className = 'sr-only'; status.setAttribute('role','status'); container.append(status);
    pre.tabIndex = 0; pre.setAttribute('aria-label',t.codeScroll);
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
        button.textContent = t.copied; status.textContent = t.copiedStatus;
      } catch {
        const range = document.createRange(); range.selectNodeContents(pre);
        const selection = window.getSelection(); selection?.removeAllRanges(); selection?.addRange(range);
        button.textContent = t.manualCopy; status.textContent = t.manualCopyStatus;
      }
      window.setTimeout(() => { button.textContent = t.copy; status.textContent = ''; },2400);
    });
  });
</script>
