---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { site } from '../config';
import { copy, getLocale, localPath } from '../i18n';
import { getPosts } from '../lib/posts';
import { lifeList } from '../data/list100';
const locale = getLocale(Astro.url.pathname);
const t = copy(locale);
const recent = (await getPosts(locale)).slice(0, 3);
const completed = lifeList.filter(({ status }) => status === 'done').length;
---
<Base title={t.about}>
  <div class="shell about-page">
    <article class="about-grid" aria-labelledby="about-title">
      <div class="about-content">
        <header class="about-heading"><p class="eyebrow">{t.aboutEyebrow}</p><h1 id="about-title">{site.name}<span class="accent">.</span></h1><p class="intro-line">{t.personalLine}</p></header>
        <div class="about-body"><p>{t.hello}</p><p>{t.introOne}</p><p>{t.introTwo}</p></div>
        {recent.length > 0 && <section class="home-section" aria-labelledby="recent-title">
          <div class="section-heading"><h2 id="recent-title">{t.recent}</h2><a class="text-link" href={localPath('/blog/', locale)}>{t.allPosts} →</a></div>
          <PostList posts={recent} headingLevel="h3" />
        </section>}
        <a class="home-progress" href={localPath('/list-100/', locale)}>
          <span>List100</span>
          <span class="home-progress-bar" aria-hidden="true"><span style={`width:${completed}%`}></span></span>
          <span class="home-progress-value">{completed} / 100</span>
        </a>
      </div>
      <aside class="about-profile" aria-label={t.profile}>
        <img src={site.avatar} width="96" height="96" alt={t.avatar} />
        <div class="profile-details">
          <p class="birth"><span>{t.born}</span><time datetime={site.birthDate}>{site.birth}</time></p>
        </div>
        <section class="experience" aria-labelledby="experience-title">
          <h2 id="experience-title">{t.experience}</h2>
          <ol>{site.experience.map(({ period, company, role }) => <li><span class="experience-period">{period}</span><span class="experience-job"><strong>{company}</strong> <span>({role})</span></span></li>)}</ol>
        </section>
      </aside>
    </article>
  </div>
</Base>
