---
import { projects } from '../config';
import Icon from './Icon.astro';
---
<div class="project-grid">
  {projects.map((project, index) => <a class="project-card" href={project.url} target="_blank" rel="noopener noreferrer">
    <div class="project-top"><span class="mono">0{index + 1} / {project.label}</span><Icon name="external" /></div>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    <div class="project-language"><span></span>{project.language}<span class="sr-only">，在 GitHub 新窗口打开</span></div>
  </a>)}
</div>
