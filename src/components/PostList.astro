---
import { dateLabel, postUrl, tagUrl, type Post } from '../lib/posts';
import Icon from './Icon.astro';
interface Props { posts: Post[]; headingLevel?: 'h2' | 'h3' }
const { posts, headingLevel: Heading = 'h2' } = Astro.props;
---
<div class="post-list">
  {posts.map((post) => (
    <article class="post-row">
      <div class="post-date"><time datetime={post.data.date}>{dateLabel(post.data.date)}</time><span>{post.data.category}</span></div>
      <div class="post-summary">
        <Heading><a href={postUrl(post)}>{post.data.title}<Icon name="external" size={20} /></a></Heading>
        <p>{post.data.description}</p>
        <div class="post-tags">{post.data.tags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}</div>
      </div>
    </article>
  ))}
</div>
