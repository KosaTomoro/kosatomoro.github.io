---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { categories, pageUrl, type Post } from '../lib/posts';
interface Props { posts: Post[]; current: number; total: number; count: number; category?: string; base: string }
const { posts, current, total, count, category, base } = Astro.props;
---
<Base title={`${category ? `${category}文章` : '文章'}${current > 1 ? ` · 第 ${current} 页` : ''}`}>
  <div class="shell page-content">
    <header class="page-heading"><span class="eyebrow">THE JOURNAL</span><h1>文字，和思考的痕迹<span class="accent">。</span></h1><p>关于技术的探索，也关于平常日子里的发现。</p></header>
    <div class="list-toolbar">
      <nav class="category-tabs" aria-label="文章分类">
        <a href="/blog/" aria-current={!category ? 'page' : undefined}>全部</a>
        {categories.map((item) => <a href={`/blog/category/${item.slug}/`} aria-current={category === item.name ? 'page' : undefined}>{item.name}</a>)}
      </nav>
      <span class="item-count">{count} 篇文章</span>
    </div>
    {posts.length ? <PostList posts={posts} /> : <div class="empty-state"><span class="empty-mark">✳</span><h2>这里的故事，还在路上。</h2><p>等有了想分享的{category === '生活' ? '生活片段' : '新发现'}，就写在这里。</p><a class="text-link" href="/blog/">先读读其他文章 →</a></div>}
    {total > 1 && <nav class="pagination" aria-label="文章分页">
      {current > 1 ? <a href={pageUrl(base, current - 1)} rel="prev">← 上一页</a> : <span></span>}
      <span>第 {current} / {total} 页</span>
      {current < total ? <a href={pageUrl(base, current + 1)} rel="next">下一页 →</a> : <span></span>}
    </nav>}
    <div class="browse-note"><span>也可以按时间或主题寻找文字</span><a href="/archive/">时间归档 ↗</a><a href="/tags/">浏览标签 ↗</a></div>
  </div>
</Base>
