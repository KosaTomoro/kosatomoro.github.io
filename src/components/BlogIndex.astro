---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { categories, type Post } from '../lib/posts';
import { copy, getLocale, localPath, categoryName, articleCount } from '../i18n';
interface Props { posts: Post[]; count: number; category?: string }
const { posts, count, category } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = copy(locale);
---
<Base title={category ? `${categoryName(category, locale)} · ${t.blog}` : t.blog}>
  <div class="shell page-content">
    <div class="list-toolbar">
      <nav class="category-tabs" aria-label={t.categories}>
        <a href={localPath('/blog/', locale)} aria-current={!category ? 'page' : undefined}>{t.all}</a>
        {categories.map((item) => <a href={localPath(`/blog/category/${item.slug}/`, locale)} aria-current={category === item.name ? 'page' : undefined}>{categoryName(item.name, locale)}</a>)}
      </nav>
      <span class="item-count">{articleCount(count, locale)}</span>
    </div>
    {posts.length ? <PostList posts={posts} /> : <div class="empty-state"><h2>{t.emptyTitle}</h2><p>{t.emptyIntro}</p><a class="text-link" href={localPath('/blog/', locale)}>{t.otherWriting} →</a></div>}
    <div class="browse-note"><a href={localPath('/archive/', locale)}>{t.byYear} →</a><a href={localPath('/tags/', locale)}>{t.browseTags} →</a><a href={localPath('/search/', locale)}>{t.fullSearch} →</a></div>
  </div>
</Base>
