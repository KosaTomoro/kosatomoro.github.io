---
import Base from '../layouts/Base.astro';
import { copy, getLocale, localPath } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = copy(locale);
---
<Base title={t.search} noindex>
  <div class="shell page-content search-page">
    <header class="page-heading"><p class="eyebrow">{t.searchEyebrow}</p><h1>{t.search}<span class="accent">.</span></h1><p>{t.searchIntro}</p></header>
    <form id="search-form" role="search" autocomplete="off">
      <label class="sr-only" for="search-input">{t.searchLabel}</label>
      <div class="search-field"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg><input id="search-input" name="q" type="search" placeholder={t.searchPlaceholder} /><button type="submit">{t.search} <span aria-hidden="true">↵</span></button></div>
    </form>
    <p id="search-status" class="search-status" role="status" aria-live="polite">{t.searchStart}</p>
    <div id="search-results" class="search-results"></div>
    <noscript><p>{t.noScript}</p></noscript>
    <div class="browse-note"><a href={localPath('/archive/',locale)}>{t.archive} →</a><a href={localPath('/tags/',locale)}>{t.tags} →</a></div>
  </div>
</Base>
<script>
  import { copy, getLocale, searchMessage } from '../i18n';
  const locale = getLocale(location.pathname);
  const t = copy(locale);
  interface SearchData { url: string; meta: { title?: string }; excerpt: string }
  interface SearchResult { data: () => Promise<SearchData> }
  interface Pagefind { search: (query: string) => Promise<{ results: SearchResult[] }> }
  const input = document.querySelector<HTMLInputElement>('#search-input')!;
  const form = document.querySelector<HTMLFormElement>('#search-form')!;
  const status = document.querySelector<HTMLElement>('#search-status')!;
  const results = document.querySelector<HTMLElement>('#search-results')!;
  let pagefind: Promise<Pagefind> | undefined;
  let sequence = 0;
  let timer: ReturnType<typeof setTimeout>;
  const loadSearch = (): Promise<Pagefind> => {
    // The index is generated after Astro's build, so Vite must leave this import alone.
    const url = '/pagefind/pagefind.js';
    return pagefind ??= import(/* @vite-ignore */ url).catch((error) => { pagefind = undefined; throw error; });
  };
  const search = async () => {
    const query = input.value.trim();
    const request = ++sequence;
    results.replaceChildren();
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', query); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    if (!query) { status.textContent = t.searchStart; return; }
    status.textContent = t.searching;
    try {
      const engine = await loadSearch();
      const response = await engine.search(query);
      if (request !== sequence) return;
      const matches = await Promise.all(response.results.slice(0, 30).map((result) => result.data()));
      if (request !== sequence) return;
      status.textContent = searchMessage(response.results.length, query, locale);
      for (const match of matches) {
        const item = document.createElement('article');
        const heading = document.createElement('h2');
        const link = document.createElement('a');
        link.href = match.url;
        link.textContent = match.meta.title ?? t.readPost;
        heading.append(link);
        const excerpt = document.createElement('p');
        // Keep only text and search highlights, never arbitrary HTML from content.
        const parsed = new DOMParser().parseFromString(match.excerpt, 'text/html');
        const appendText = (source: Node, target: Node) => {
          for (const child of source.childNodes) {
            if (child.nodeType === Node.TEXT_NODE) target.appendChild(document.createTextNode(child.textContent ?? ''));
            else if (child instanceof Element && child.tagName === 'MARK') { const mark = document.createElement('mark'); mark.textContent = child.textContent; target.appendChild(mark); }
            else appendText(child, target);
          }
        };
        appendText(parsed.body, excerpt);
        item.append(heading, excerpt);
        results.append(item);
      }
    } catch {
      if (request !== sequence) return;
      status.textContent = import.meta.env.DEV ? t.searchDev : t.searchFailure;
      const retry = document.createElement('button');
      retry.type = 'button'; retry.className = 'text-link'; retry.textContent = t.retry; retry.addEventListener('click', search); results.append(retry);
    }
  };
  form.addEventListener('submit', (event) => { event.preventDefault(); clearTimeout(timer); void search(); });
  input.addEventListener('input', () => { ++sequence; clearTimeout(timer); timer = setTimeout(search, 200); });
  input.value = new URL(location.href).searchParams.get('q') ?? '';
  if (input.value) void search();
</script>
