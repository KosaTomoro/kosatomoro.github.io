---
import Icon from './Icon.astro';
import { site } from '../config';
const current = Astro.url.pathname;
const navigation = [{ href: '/', label: '首页' }, { href: '/blog/', label: '文章' }, { href: '/archive/', label: '归档' }, { href: '/projects/', label: '项目' }];
const isActive = (href: string) => href === '/' ? current === '/' : current.startsWith(href);
---
<header class="site-header shell">
  <a class="wordmark" href="/" aria-label={`${site.name} 首页`}>Kosa<span class="wordmark-dot">.</span></a>
  <div class="header-end">
    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map(({ href, label }) => <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="header-tools">
      <a class="icon-button" href="/search/" aria-label="搜索文章" aria-current={current === '/search/' ? 'page' : undefined}><Icon name="search" size={19} /></a>
      <button class="icon-button theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题" hidden>
        <span class="theme-moon"><Icon name="moon" size={19} /></span><span class="theme-sun"><Icon name="sun" size={19} /></span>
      </button>
    </div>
    <details class="mobile-menu">
      <summary class="icon-button" aria-label="展开导航菜单"><Icon name="menu" /></summary>
      <nav aria-label="移动端导航">
        {navigation.map(({ href, label }) => <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>)}
        <a href="/tags/">标签</a>
      </nav>
    </details>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  let manual = false;
  try { manual = ['light', 'dark'].includes(localStorage.getItem('theme') ?? ''); } catch {}
  const updateLabel = () => toggle?.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? '切换到浅色主题' : '切换到深色主题');
  if (toggle) { toggle.hidden = false; updateLabel(); }
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    manual = true;
    try { localStorage.setItem('theme', next); } catch {}
    updateLabel();
  });
  media.addEventListener('change', ({ matches }) => {
    if (!manual) { document.documentElement.dataset.theme = matches ? 'dark' : 'light'; updateLabel(); }
  });
  document.addEventListener('keydown', (event) => {
    const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
</script>
