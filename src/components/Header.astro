---
import Icon from './Icon.astro';
import { site } from '../config';
const current = Astro.url.pathname;
const navigation = [{ href: '/', label: 'About' }, { href: '/blog/', label: 'Blog' }, { href: '/archive/', label: 'Archive' }];
const isActive = (href: string) => href === '/' ? current === '/' : current.startsWith(href);
---
<header class="site-header shell">
  <nav class="primary-nav" aria-label="主导航">
    {navigation.map(({ href, label }) => <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>)}
    <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">（新窗口）</span></a>
  </nav>
  <button class="icon-button theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题" hidden>
    <span class="theme-moon"><Icon name="moon" size={20} /></span><span class="theme-sun"><Icon name="sun" size={20} /></span>
  </button>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const updateLabel = () => toggle?.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? '切换到浅色主题' : '切换到深色主题');
  if (toggle) { toggle.hidden = false; updateLabel(); }
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    updateLabel();
  });
</script>
