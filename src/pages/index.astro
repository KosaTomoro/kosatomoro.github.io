---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCards from '../components/ProjectCards.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
---
<Base>
  <div class="shell">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="tiny-line"></span> A PERSONAL CORNER OF THE INTERNET</div>
        <p class="hello">你好，我是</p>
        <h1 id="intro-title">{site.name}<span class="accent">.</span></h1>
        <p class="hero-description">记录技术实践、阅读与生活。<br />在这里，让想法慢慢长成文字。</p>
        <a class="text-link hero-link" href="/blog/">读一读我的文章 <Icon name="arrow" size={18} /></a>
      </div>
      <div class="portrait-block">
        <div class="portrait-frame"><img src={site.avatar} width="176" height="176" alt="Kosa Tomoro 的 GitHub 头像" fetchpriority="high" /></div>
        <p class="portrait-caption">保持好奇，慢慢生长。</p>
        <a class="profile-link" href={site.github} target="_blank" rel="noopener noreferrer">@KosaTomoro <Icon name="external" size={15} /><span class="sr-only">（新窗口）</span></a>
      </div>
    </section>
    <div class="intro-note"><span class="note-star" aria-hidden="true">✳</span><p>{site.intro}</p><span class="note-motto">{site.motto}</span></div>
    <section class="home-section" aria-labelledby="writing-title">
      <div class="section-heading"><div><span class="eyebrow">01 / WRITING</span><h2 id="writing-title">最近的文字</h2></div><a class="section-link" href="/blog/">全部文章 <Icon name="arrow" size={17} /></a></div>
      {posts.length ? <PostList posts={posts.slice(0, 3)} headingLevel="h3" /> : <p class="empty-state">第一篇文字，正在酝酿。</p>}
    </section>
    <section class="home-section projects-section" aria-labelledby="projects-title">
      <div class="section-heading"><div><span class="eyebrow">02 / BUILDING</span><h2 id="projects-title">把想法写成代码</h2></div><a class="section-link" href="/projects/">查看项目 <Icon name="arrow" size={17} /></a></div>
      <ProjectCards />
    </section>
    <aside class="closing-note"><span>文字留在这里，生活继续向前。</span><a href={site.rss}>通过 RSS 订阅更新 <Icon name="rss" size={16} /></a></aside>
  </div>
</Base>
