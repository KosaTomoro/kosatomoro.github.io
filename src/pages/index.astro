---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---
<Base title="About">
  <div class="shell about-page">
    <article class="about-grid" aria-labelledby="about-title">
      <header class="about-heading">
        <h1 id="about-title">{site.name}<span class="accent">.</span></h1>
        <p>{site.motto}</p>
      </header>
      <aside class="about-profile" aria-label="个人资料">
        <img src={site.avatar} width="176" height="176" alt="Kosa Tomoro 的头像" />
        <div class="profile-details">
          <p class="profile-name">{site.name}</p>
          <dl>
            <div><dt>Born</dt><dd>{site.birth}</dd></div>
          </dl>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">（新窗口）</span></a>
        </div>
        <section class="experience" aria-labelledby="experience-title">
          <h2 id="experience-title">Working experience</h2>
          <ol>
            {site.experience.map(({ period, company, role }) => <li>
              <span class="experience-period">{period}</span>
              <span class="experience-position"><strong>{company}</strong><span>{role}</span></span>
            </li>)}
          </ol>
        </section>
      </aside>
      <div class="about-body">
        <h2>Hi, I'm Kosa Tomoro.</h2>
        <p class="about-lead">这里是我的个人博客。</p>
        <p>我会在这里记录技术实践中的发现，整理对工程问题的思考，也写下一些关于阅读和生活的片段。</p>
        <p>写作对我来说，是把零散想法慢慢整理清楚的过程。希望这些文字能留下走过的路，也能偶尔给读到它的人一点启发。</p>
        <p>欢迎来读我的文章，也欢迎通过 GitHub 了解我正在关注和学习的内容。</p>
        <p class="signature"><span>Best,</span><strong>Kosa</strong></p>
      </div>
      <nav class="about-links" aria-label="继续浏览">
        <a href="/blog/">开始阅读 <span aria-hidden="true">↗</span></a>
        <a href="/search/">搜索文章 <span aria-hidden="true">↗</span></a>
      </nav>
    </article>
  </div>
</Base>
