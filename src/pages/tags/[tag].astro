---
import Page from '../../components/TagsPage.astro';
import { getPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap(({data})=>data.tags))].map(tag=>({params:{tag},props:{tag}}));
}
---
<Page {...Astro.props} />
