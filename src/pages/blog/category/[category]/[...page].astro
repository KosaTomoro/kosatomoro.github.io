---
import BlogIndex from '../../../../components/BlogIndex.astro';
import { getPosts, pageEntries, categories } from '../../../../lib/posts';
export async function getStaticPaths() {
  const all = await getPosts();
  return categories.flatMap((category) => {
    const posts = all.filter(({ data }) => data.category === category.name);
    return pageEntries(posts).map(({ page, ...props }) => ({ params: { category: category.slug, page }, props: { ...props, category: category.name, count: posts.length, base: `/blog/category/${category.slug}/` } }));
  });
}
---
<BlogIndex {...Astro.props} />
